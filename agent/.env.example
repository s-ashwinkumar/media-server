# =============================================================================
# DISCORD MEDIA SERVER AGENT CONFIGURATION
# =============================================================================

# Discord Bot Credentials
# Get your bot token from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Access Controls:
# 1. Administrator User IDs (Full access: Docker restarts, release grabbing, logs, storage)
DISCORD_ADMIN_USER_IDS=123456789012345678

# 2. Optional Whitelist for Regular Users:
# LEAVE THIS EMPTY to allow ANYONE in your private Discord server to chat with the bot (as non-admin).
DISCORD_ALLOWED_USER_IDS=

# OpenRouter LLM Configuration
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Priority Model Cascade (100% Free via Google AI Studio BYOK):
# 1. google/gemini-3.5-flash        -> Google Flash Flagship ($0.00 Free via BYOK)
# 2. google/gemini-3.5-flash-lite   -> Ultra-fast secondary fallback ($0.00 Free via BYOK)
# 3. google/gemini-3.1-flash-lite   -> Reliable tertiary fallback ($0.00 Free via BYOK)
OPENROUTER_MODELS=google/gemini-3.5-flash,google/gemini-3.5-flash-lite,google/gemini-3.1-flash-lite

# Service Endpoints (Defaults to localhost ports if left blank)
RADARR_URL=http://localhost:7878
SONARR_URL=http://localhost:8989
QBITTORRENT_URL=http://localhost:8080
JELLYFIN_URL=http://localhost:8096
JELLYSEERR_URL=http://localhost:5055

# Note: API keys are automatically imported from ../compose_files/.env
