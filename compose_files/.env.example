# =============================================================================
# MEDIA SERVER ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to compose_files/.env and customize according to your setup
# cp compose_files/.env.example compose_files/.env

# =============================================================================
# BASE CONFIGURATION
# =============================================================================
TZ=America/Los_Angeles

# =============================================================================
# SURFSHARK VPN CONFIGURATION (Required)
# =============================================================================
OPENVPN_USER=your_surfshark_username
OPENVPN_PASSWORD=your_surfshark_password
SERVER_COUNTRIES=UnitedStates  # Choose your preferred country
SERVER_HOSTNAMES=us-sjc.prod.surfshark.com,us-sfo.prod.surfshark.com,us-lax.prod.surfshark.com,us-slc.prod.surfshark.com # Server hostname for your country

# =============================================================================
# OPTIONAL: FLARESOLVERR CONFIGURATION
# =============================================================================
# LOG_LEVEL=info
# LOG_HTML=false
# CAPTCHA_SOLVER=none
DOWNLOADS_PATH=/home/mediaserver/Downloads
JELLYFIN_CACHE_PATH=/home/mediaserver/mediaserver/cache
CONFIGS_PATH=/home/mediaserver/mediaserver/configs
TV_SHOWS_PATH=/media/mediaserver/media/tv-series
MOVIES_PATH=/media/mediaserver/media/movies
COLD_MOVIES_PATH=/media/mediaserver/SAMSUNG/movies
COLD_TV_SHOWS_PATH=/media/mediaserver/SAMSUNG/tv-series
BOOKS_PATH=/media/mediaserver/SAMSUNG/Books